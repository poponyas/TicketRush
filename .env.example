# Credentials for local development only.
POSTGRES_DB=ticketrush
POSTGRES_USER=ticketrush
POSTGRES_PASSWORD=ticketrush_dev
DATABASE_URL=postgres://ticketrush:ticketrush_dev@localhost:5433/ticketrush?sslmode=disable

LOGGER_LEVEL=DEBUG
LOGGER_FOLDER=logs
HTTP_ADDR=127.0.0.1:8080
# Local Postman identity; disabled by default. No JWT authentication yet.
DEV_AUTH_ENABLED=false
# Server-configured local roles; use ownerVenue for venues or buyer,organizer,ownerVenue for both.
DEV_ROLES=buyer,organizer
DEV_USER_ID=22222222-2222-4222-8222-222222222222
DEV_ORGANIZER_ID=33333333-3333-4333-8333-333333333333
