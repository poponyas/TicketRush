# Credentials for local development only.
POSTGRES_DB=ticketrush
POSTGRES_USER=ticketrush
POSTGRES_PASSWORD=ticketrush_dev
DATABASE_URL=postgres://ticketrush:ticketrush_dev@localhost:5433/ticketrush?sslmode=disable

LOGGER_LEVEL=DEBUG
LOGGER_FOLDER=logs
HTTP_ADDR=127.0.0.1:8080
# Local Postman identity; disabled by default.
# When false, protected routes require an access JWT and an active login session.
DEV_AUTH_ENABLED=false
# Server-configured local roles; use ownerVenue for venues or buyer,organizer,ownerVenue for both.
DEV_ROLES=buyer,organizer
DEV_USER_ID=22222222-2222-4222-8222-222222222222
DEV_ORGANIZER_ID=33333333-3333-4333-8333-333333333333

# Required for token issuance. Generate a private local value with: openssl rand -hex 32
# Do not commit the generated secret.
JWT_SECRET_HEX=

# Local seed account (created by make seed / make run):
# Email: organizer@example.test
# Password: TicketRush-demo-2026!
# Organizer header: X-Organizer-ID: 33333333-3333-4333-8333-333333333333
# Copy this file to .env and fill JWT_SECRET_HEX before the first run.
